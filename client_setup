# Download and add the GPG key
curl -fsSL http://your-server/gpg/public.key | sudo gpg --dearmor -o /usr/share/keyrings/aptly-archive-keyring.gpg

# Add repository WITHOUT [trusted=yes] since it's properly signed
echo "deb [signed-by=/usr/share/keyrings/aptly-archive-keyring.gpg] http://your-server/ jammy-artifacts main" | sudo tee /etc/apt/sources.list.d/custom-artifacts.list

# Update and install
sudo apt update
sudo apt install your-package
