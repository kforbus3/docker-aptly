#!/bin/bash

# Use environment variables or defaults
GPG_NAME_REAL=${GPG_NAME_REAL:-Aptly Repository}
GPG_NAME_EMAIL=${GPG_NAME_EMAIL:-repo@yourdomain.com}
# Where to write the exported keys (defaults to the container's data volume;
# set GPG_OUT_DIR when running this standalone on a host).
GPG_OUT_DIR=${GPG_OUT_DIR:-/data/gpg}
mkdir -p "$GPG_OUT_DIR"

# Create GPG key batch file with configurable values
cat > /tmp/gpg-batch << EOF
Key-Type: RSA
Key-Length: 4096
Name-Real: $GPG_NAME_REAL
Name-Email: $GPG_NAME_EMAIL
Expire-Date: 0
%no-protection
%commit
EOF

# Generate key
gpg --batch --generate-key /tmp/gpg-batch

# Export with proper permissions
gpg --export-secret-keys --armor "$GPG_NAME_EMAIL" > "$GPG_OUT_DIR/private.key"
chmod 600 "$GPG_OUT_DIR/private.key"
chown $(id -u):$(id -g) "$GPG_OUT_DIR/private.key"

# Export public key for clients
gpg --export --armor "$GPG_NAME_EMAIL" > "$GPG_OUT_DIR/public.key"
chmod 644 "$GPG_OUT_DIR/public.key"
